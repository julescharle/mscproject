  if (tstype == "MA"){
    ts_generate <- function(n, tsparams){
      theta_x <- tsparams[1]; theta_y <- tsparams[2]; delta <- tsparams[3]; delay <- tsparams[4]
      
      epsilon_x <- rnorm(n); X <- numeric(n); X[1] <- epsilon_x[1]
      epsilon_y <- rnorm(n); Y <- numeric(n); Y[1] <- epsilon_y[1]
      
      for (i in 2:n){
        X[i] <- theta_x * epsilon_x[i-1] + epsilon_x[i]
        Y[i] <- theta_y * epsilon_y[i-1] + epsilon_y[i]
