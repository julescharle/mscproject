      df_x <- tsparams[7]; df_y <- tsparams[8]; delay <- tsparams[9]; 
      
      scale_x <- sqrt((df_x - 2) / df_x) #we need to scale to ensure the variance of etas is 1 to ensure a valid GARCH process
      eta_x <- rt(n, df_x) * scale_x
      scale_y <- sqrt((df_y - 2) / df_y)
