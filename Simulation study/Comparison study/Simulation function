library(lmtest)
library(doParallel)
library(parallel)

# Parallel compute for running GC tests
# Inputs
# tstype: the user can choose from a pre-defined data generating process:
# Choosing a pre-defined data generating process.
# ---------------------------------------------------------
# "WN" - bivariate white noise sequence
# Ground truth: no causality
# std normal iid noise
# no need to define tsparams
# ---------------------------------------------------------
# "WNheavy" - bivariate white noise sequence
# Ground truth: no causality
# t-distributed iid noise, tsparams length 2:
# df_x, df_y
# ---------------------------------------------------------
# "WNTWO" - bivariate white noise sequence with causal interaction term
# Ground truth: X causes Y, Y does not cause X
# std normal iid noise, tsparams length 2:
# theta, delay
# ---------------------------------------------------------
# "WNTWOheavy" - bivariate white noise sequence with causal interaction term
# Ground truth: X causes Y, Y does not cause X
# t-distributed iid noise, tsparams length 4:
# theta, df_x, df_y, delay
# ---------------------------------------------------------
# "GARCH" - bivariate GARCH(1,1) with causal interaction term
# Ground truth: X causes Y, Y does not cause X
# std normal etas, tsparams length 7:
# omega, alpha, beta, theta_x, theta_y, delta, delay
# ---------------------------------------------------------
# "GARCHheavy" bivariate GARCH(1,1) with causal interaction term
# Ground truth: X causes Y, Y does not cause X
# normalised t-distributed etas with d.f. =  df, tsparams length 9:
# omega, alpha, beta, theta_x, theta_y, delta, df_x, df_y delay
# ---------------------------------------------------------
# "MA" bivariate MA(1) with nonlinear causal interaction term
# Ground truth: X causes Y, Y does not cause X
# std normal iid noise, tsparams length 4:
# theta_x, theta_y, delta, delay
# ---------------------------------------------------------
# "MAheavy" bivariate MA(1) with nonlinear interaction term
# Ground truth: X causes Y, Y does not cause X
# t-distributed iid noise, tsparams length 6:
# theta_x, theta_y, df_x, df_y, delta, delay
# ---------------------------------------------------------
# "VAR" bivariate VAR(1) system with causal interaction term
# Ground truth: X causes Y, Y does not cause X
# std normal iid noise, tsparams length 4:
# phi_x, phi_y, delta, delay
# ---------------------------------------------------------
# "VARheavy" bivariate VAR(1) system with causal interaction term
# Ground truth: X causes Y, Y does not cause X
# t-distributed iid noise, tsparams length 6:
# phi_x, phi_y, df_x, df_y, delta, delay
# ---------------------------------------------------------
# "GARCHVOL" - bivariate MA(1)-GARCH(1,1), interaction in the VARIANCE of Y
# Ground truth: X causes Y, Y does not cause X 
# std normal etas, tsparams length 7:
# omega, alpha, beta, theta_x, theta_y, delta, delay
# ---------------------------------------------------------
# "GARCHVOLheavy" - as above with normalised t etas, tsparams length 9:
# omega, alpha, beta, theta_x, theta_y, delta, df_x, df_y, delay
# ---------------------------------------------------------
# "WNSQ" - white noise with squared causal interaction term
# Ground truth: X causes Y 
# std normal iid noise, tsparams length 2:
# delta, delay
# ---------------------------------------------------------
# "WNSQheavy" - as above, t noise normalised
# tsparams length 4:
# delta, df_x, df_y, delay
# ---------------------------------------------------------
# ---------------------------------------------------------
# Test choices:
# SMBB_ROW_CEN is rows + centred "smbb" (SMBB_1 in report)
# SMBB_ROW_UNC is rows + uncentred "smbbu" (SMBB_2 in report)
# SMBB_RAW_CEN is raw  + centred "smbbraw" (SMBB_3 in report)
# SMBB_RAW_UNC is raw  + uncentred "smbbrawu" (SMBB_4 in report)
# SHIFTED_TEST runs all smbbs
# MBB_TEST is non-shifted (standard) MBB
# AR_TEST is AR sieve bootstrap residual test
# ASYMPTOTIC_TEST is classic F-test
# ROBUST_TEST is Wald test with heteroscedsatic-robust estimator (HC3)
# TY_TEST is Toda-Yamamoto test
# Parameters:
# N_SIM is number of replications. N in report
# N_LENGTH length of time series generated. n in report
# B_BOOT bootstrap repetitions. B in report
# LAG lag for GC tests (used only when LAG_SELECT = FALSE). p in report
# LAG_SELECT if TRUE, lag is re-chosen per replication by VARselect and the lag argument is ignored and the lag used is returned
# SHIFT is shift parameter for smbb
# BLOCK is the moving block length
# Returns a list:
#   $table  rejection rates at the 5% level (the old return value)
#   $obs    observed statistic per replication, per test and direction
#   $boot   N_SIM x B_BOOT matrix of bootstrap statistics, per bootstrap test and direction (NULL for tests with no bootstrap distribution)
#   $lag    lag used in each replication
#   $params the parameters the run was made with


cluster_runner <- function(tstype, tsparams = 0,
                           SHIFTED_TEST = T,
                           SMBB_ROW_CEN = SHIFTED_TEST,
                           SMBB_ROW_UNC = SHIFTED_TEST,
                           SMBB_RAW_CEN = SHIFTED_TEST,
                           SMBB_RAW_UNC = SHIFTED_TEST,
                           AR_TEST = T,
                           MBB_TEST = T, ASYMPTOTIC_TEST = T, ROBUST_TEST = T,
                           TY_TEST = T,
                           N_SIM = 100, N_LENGTH = 1000, B_BOOT = 100,
                           LAG = 1, LAG_SELECT = F, SHIFT = 2,
                           BLOCK = floor(N_LENGTH^(14/29))){
  
    SMBB_ROW_CEN <- isTRUE(SMBB_ROW_CEN)
  SMBB_ROW_UNC <- isTRUE(SMBB_ROW_UNC)
  SMBB_RAW_CEN <- isTRUE(SMBB_RAW_CEN)
  SMBB_RAW_UNC <- isTRUE(SMBB_RAW_UNC)
  
  
  ##### ------ Choosing data generating process ------ #####
  # Preset data generating processes 
  if (tstype == "WN"){
    ts_generate <- function(n, tsparams){
      X <- rnorm(n); Y <- rnorm(n)
      return(data.frame(X,Y))
    }
  }
  
  if (tstype == "WNheavy"){
    ts_generate <- function(n, tsparams){
      df_x <- tsparams[1]; df_y <- tsparams[2]
      X <- rt(n, df_x); Y <- rt(n, df_y)
      return(data.frame(X,Y))
    }
  }
  
  if (tstype == "WNTWO"){
    ts_generate <- function(n, tsparams){
      theta <- tsparams[1]
      delay <- tsparams[2]
      X <- rnorm(n)
      Y <- rnorm(n)
      for (i in (delay + 1):n){
        Y[i] <- Y[i] + theta * X[i - delay]
      }
      return(data.frame(X, Y))
    }
  }
  
  if (tstype == "WNTWOheavy"){
    ts_generate <- function(n, tsparams){
      theta <- tsparams[1]; df_x <- tsparams[2]
      df_y <- tsparams[3]; delay <- tsparams[4]
      X <- rt(n, df_x); Y <- rt(n, df_y)
