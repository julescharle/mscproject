library(ggplot2)

set.seed(1234)

ts_generate <- function(n, tsparams){
  phi_x <- tsparams[1:3]; phi_y <- tsparams[4:6]
  delta <- tsparams[7];   delay <- tsparams[8];  rho <- tsparams[9]

  epsilon_x <- rnorm(n); X <- numeric(n); X[1:3] <- epsilon_x[1:3]
  epsilon_y <- rho * epsilon_x + sqrt(1 - rho^2) * rnorm(n)
  Y <- numeric(n); Y[1:3] <- epsilon_y[1:3]

  for (i in 4:n){
    X[i] <- phi_x[1] * X[i-1] + phi_x[2] * X[i-2] + phi_x[3] * X[i-3] +
      epsilon_x[i]

    Y[i] <- phi_y[1] * Y[i-1] + phi_y[2] * Y[i-2] + phi_y[3] * Y[i-3] +
      epsilon_y[i]

    if (i > delay) {
      Y[i] <- Y[i] + delta * X[i-delay]
    }
  }
  data.frame(X, Y)
}

build_design <- function(X, Y, p) {
  y_embed <- embed(Y, p + 1)
  x_embed <- embed(X, p + 1)
  cbind(y_embed[, 1],
        y_embed[, -1, drop = FALSE],
        x_embed[, -1, drop = FALSE])
}

fstat_design <- function(D, p, delta = NULL) {
  y_target <- D[, 1]
  y_lags   <- D[, 2:(p + 1), drop = FALSE]
  x_lags   <- D[, (p + 2):(2 * p + 1), drop = FALSE]

  if (!is.null(delta)) y_target <- y_target - (x_lags %*% delta)

  unrestricted <- lm.fit(x = cbind(1, y_lags, x_lags), y = y_target)
  restricted   <- lm.fit(x = cbind(1, y_lags),         y = y_target)

  rss_u <- sum(unrestricted$residuals^2)
  rss_r <- sum(restricted$residuals^2)
  m <- length(y_target)

  ((rss_r - rss_u) / p) / (rss_u / (m - 2 * p - 1))
}

fstat_raw <- function(X, Y, p, delta = NULL) {
  fstat_design(build_design(X, Y, p), p, delta)
}

delta_hat <- function(D, p) {
  cf <- lm.fit(x = cbind(1, D[, 2:(p + 1), drop = FALSE],
                         D[, (p + 2):(2 * p + 1), drop = FALSE]),
               y = D[, 1])$coefficients
  cf[(p + 2):(2 * p + 1)]
}

mbb_rows <- function(M, l) {
  m  <- nrow(M)
  nb <- ceiling(m / l)
  starts <- sample.int(m - l + 1L, nb, replace = TRUE)
  idx <- rep(starts, each = l) + rep(0:(l - 1L), times = nb)
  M[idx[seq_len(m)], , drop = FALSE]
}

one_rep <- function(n, p, shift, B, l, tsparams) {
  d <- ts_generate(n, tsparams)
  X <- d$X; Y <- d$Y

  F_obs <- fstat_raw(X, Y, p)

  Yp <- c(tail(Y, shift), head(Y, -shift))
  D  <- build_design(X, Yp, p)
  dh <- delta_hat(D, p)
  raw <- cbind(X, Yp)

  out <- matrix(NA_real_, B, 4)
  for (b in seq_len(B)) {
    rs <- mbb_rows(raw, l)
    Dc <- build_design(rs[, 1], rs[, 2], p)
    out[b, 1] <- fstat_design(Dc, p, NULL)
    out[b, 2] <- fstat_design(Dc, p, dh)

    Dd <- mbb_rows(D, l)
    out[b, 3] <- fstat_design(Dd, p, NULL)
    out[b, 4] <- fstat_design(Dd, p, dh)
  }
  list(F_obs = F_obs, boot = out)
}

run_simulation_data <- function(n, p, shift, B, l, tsparams, N_SIM, facet_label) {

  res <- lapply(seq_len(N_SIM), function(i) one_rep(n, p, shift, B, l, tsparams))

  F_actual <- vapply(res, `[[`, numeric(1), "F_obs")
  boot <- do.call(rbind, lapply(res, `[[`, "boot"))
  labs <- c("naive, unadjusted", "naive, adjusted",
            "lag first, unadjusted", "lag first, adjusted")
  colnames(boot) <- labs

  pr <- seq(0.005, 0.995, by = 0.005)
  qq <- cbind(
    data.frame(actual = quantile(F_actual, pr, names = FALSE)),
    as.data.frame(apply(boot, 2, quantile, probs = pr, names = FALSE),
                  check.names = FALSE))

  qq_long <- reshape(qq, direction = "long",
                     varying = labs, v.names = "sample",
                     timevar = "statistic", times = labs, idvar = "actual")

  qq_long$statistic <- factor(qq_long$statistic, levels = labs)
  qq_long$facet <- facet_label

  q95_actual <- quantile(F_actual, 0.95, names = FALSE)
  cross_data <- data.frame(actual = q95_actual, sample = q95_actual, facet = facet_label)

  list(qq_long = qq_long, cross_data = cross_data)
}

n        <- 1000
N_SIM    <- 500
B        <- 200
shift    <- 100
tsparams <- c(0.5, 0.2, 0.1, 0.5, 0.2, 0.1, 0.0, 3, 0.4)

data_left <- run_simulation_data(
  n = n, p = 2, shift = shift, B = B, l = floor(n^(14/29)),
  tsparams = tsparams, N_SIM = N_SIM, facet_label = "p = 2, l = 28"
)

data_right <- run_simulation_data(
  n = n, p = 7, shift = shift, B = B, l = floor(n^(1/3)),
  tsparams = tsparams, N_SIM = N_SIM, facet_label = "p = 7, l = 10"
)

final_qq <- rbind(data_left$qq_long, data_right$qq_long)
final_cross <- rbind(data_left$cross_data, data_right$cross_data)

facet_levels <- c("p = 2, l = 28", "p = 7, l = 10")
final_qq$facet <- factor(final_qq$facet, levels = facet_levels)
final_cross$facet <- factor(final_cross$facet, levels = facet_levels)

ggplot(final_qq, aes(actual, sample, colour = statistic)) +
  geom_abline(slope = c(1, 2), linetype = "dashed", colour = "grey40") +
  geom_line() +
  facet_wrap(~ facet, ncol = 2, scales = "free") +
  labs(x = expression(chi[p]^2/p~quantile), y = "Bootstrap quantile") +
  theme_bw(base_size = 9) +
  theme(legend.title = element_blank(),
        panel.grid.minor = element_blank(),
        strip.text = element_blank(),
        strip.background = element_blank(),
        legend.position = "bottom")
