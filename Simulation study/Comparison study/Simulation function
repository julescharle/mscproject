    }
  }
  
  if (tstype == "GARCH"){
    ts_generate <- function(n, tsparams){
      #initialise
      omega <- tsparams[1] ; alpha <- tsparams[2]; beta <- tsparams[3]
      theta_x <- tsparams[4]; theta_y <- tsparams[5]; delta <- tsparams[6]
      delay <- tsparams[7]
      
      eta_x <- rnorm(n); eta_y <- rnorm(n)
      sig_x <- numeric(n); sig_y <- numeric(n) # here sig actually represents sigma squared
      eps_x <- numeric(n); eps_y <- numeric(n)
      X <- numeric(n); Y <- numeric(n)
      
      sig_x[1] <- sig_y[1] <- omega / (1 - alpha - beta) #this is the long run expected variance of GARCH(1,1), so initalising here seems right
      eps_x[1] <- sqrt(sig_x[1]) * eta_x[1]
      eps_y[1] <- sqrt(sig_y[1]) * eta_y[1]
      X[1] <- eps_x[1]
      Y[1] <- eps_y[1]
      
      for (i in 2:n){
        sig_x[i] <- omega + alpha * eps_x[i-1]^2 + beta * sig_x[i-1]
        sig_y[i] <- omega + alpha * eps_y[i-1]^2 + beta * sig_y[i-1]
        eps_x[i] <- sqrt(sig_x[i]) * eta_x[i]
        eps_y[i] <- sqrt(sig_y[i]) * eta_y[i]
        X[i] <- eps_x[i] + theta_x * eps_x[i-1]
        Y[i] <- eps_y[i] + theta_y * eps_y[i-1]
      }
      for (i in (delay+1):n){ #we can just add the causal part on at the end since y doesn't use past y
        Y[i] <- Y[i] + delta * X[i-delay]
      }
      
      return(data.frame(X, Y))
      
    }
  }
  
